  definition:
    version: 1
    kind: 1
    id: archive-a17
    title: "Kay\u0131t A-17"
    description: "Koruyucu kaplaman\u0131n ar\u015Fiv numunesi bulundu. Analiz\xF6rde
      bu referans\u0131n rengini, yo\u011Funlu\u011Funu ve miktar\u0131n\u0131 yeniden
      elde et."
    rules:
      minParts: 3
      maxParts: 10
      minSamples: 1
      maxSamples: 3
      maxDepth: 10
      traceCount: 2
      parts:
      - itemID: mix-source
        allowed: 1
        minimum: 0
        maximum: 1
        explanation: "1 doz renksiz ta\u015F\u0131y\u0131c\u0131 s\u0131v\u0131 verir.
          Pigment i\xE7ermez."
      - itemID: mix-red
        allowed: 1
        minimum: 0
        maximum: 4
        explanation: "Kar\u0131\u015F\u0131ma 1 doz k\u0131rm\u0131z\u0131 pigment
          ekler; miktar 1 doz artar."
      - itemID: mix-green
        allowed: 1
        minimum: 0
        maximum: 4
        explanation: "Kar\u0131\u015F\u0131ma 1 doz ye\u015Fil pigment ekler; miktar
          1 doz artar."
      - itemID: mix-blue
        allowed: 1
        minimum: 0
        maximum: 4
        explanation: "Kar\u0131\u015F\u0131ma 1 doz mavi pigment ekler; miktar 1
          doz artar."
      - itemID: mix-solvent
        allowed: 1
        minimum: 0
        maximum: 4
        explanation: "1 doz renksiz ta\u015F\u0131y\u0131c\u0131 ekler. Yo\u011Funluk
          azal\u0131r, miktar artar."
      - itemID: mix-concentrator
        allowed: 1
        minimum: 0
        maximum: 4
        explanation: "Ta\u015F\u0131y\u0131c\u0131n\u0131n yar\u0131s\u0131n\u0131
          al\u0131r. Yo\u011Funluk artar, miktar azal\u0131r."
      - itemID: mix-splitter
        allowed: 0
        minimum: 0
        maximum: 4
        explanation: "Kar\u0131\u015F\u0131m\u0131 iki e\u015Fit kola b\xF6ler; her
          kolda her bile\u015Fenin yar\u0131s\u0131."
      - itemID: mix-mixer
        allowed: 0
        minimum: 0
        maximum: 4
        explanation: "\u0130ki giri\u015Ften gelen s\u0131v\u0131lar\u0131 toplar.
          \u0130ki giri\u015F de ba\u011Flanmal\u0131."
      - itemID: mix-meter
        allowed: 1
        minimum: 0
        maximum: 1
        explanation: "Son kar\u0131\u015F\u0131m\u0131n rengini, yo\u011Funlu\u011Funu
          ve miktar\u0131n\u0131 \xF6l\xE7er."
