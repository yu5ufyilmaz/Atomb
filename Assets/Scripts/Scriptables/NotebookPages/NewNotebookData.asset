  m_Script: {fileID: 11500000, guid: 678071f77bacfdd439997b9eb5d5ad24, type: 3}
  m_Name: NewNotebookData
  m_EditorClassIdentifier: Assembly-CSharp::NotebookData
  tutorialPages:
  - title: CORE PRESSURE
    content: Watch the gauge. If it hits RED, we die. Turn the valves to lower the
      pressure.
  - title: POWER GRID
    content: Blackouts will happen. Find the Breaker Box fast. Do not stay in the
      dark.
  - title: 'SURVIVAL PROTOCOL: LEE'
    content: DO NOT RUN. Turn your back, stand completely still, and never look at
      it.
  symbolDescriptions:
  - '[+] Receive the greeting of the four-eyed man where it all began.'
  - '[-] Subtraction: Destructive interference detected. Use this to bleed off excess
    steam.'
  - '[/] Division: Signal fragmentation. It divides the pressure load across sub-systems.'
